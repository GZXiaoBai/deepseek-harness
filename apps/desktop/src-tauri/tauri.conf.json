{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Harness",
  "version": "0.1.1-rc.1",
  "identifier": "ai.deepseek.harness",
  "build": {
    "frontendDist": "../static"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "DeepSeek Harness",
        "url": "startup.html",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "visible": true,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'none'; style-src 'unsafe-inline'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/GZXiaoBai/deepseek-harness/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyQzAwMzNFOTZGN0ZGMDQKUldRRS8vZVdQZ1BBb25lb0txMDVjT3psb3NlVnZlZEdsR1A3dk1rT25nR0ZjdmlPMXlrN1hENWMK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "externalBin": [
      "binaries/dsh-desktop-sidecar"
    ],
    "icon": [
      "icons/icon.png",
      "../build/icon.icns",
      "../build/icon.ico"
    ]
  }
}
